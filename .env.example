# Copy these values into Vercel Project Settings → Environment Variables.
# Never commit real credentials or paste them into source code.
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
ADMIN_PASSWORD=replace-with-a-random-secret-at-least-16-characters
ADMIN_AUTH_SECRET=replace-with-at-least-32-random-bytes-in-hex
